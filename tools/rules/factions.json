 "bloodAngels":      { "wahapedia": ["SM"], "bsdata": ["Imperium - Blood Angels.json", "Imperium - Space Marines.json"], "packVersion": "app-2.8.1", "wahapediaVersion": "app-2.8.1" },
 "spaceWolves":      { "wahapedia": ["SM"], "bsdata": ["Imperium - Space Wolves.json", "Imperium - Space Marines.json"], "packVersion": "app-2.8.1", "wahapediaVersion": "app-2.8.1" }
