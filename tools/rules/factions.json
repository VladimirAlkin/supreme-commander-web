 "imperialKnights":  { "wahapedia": ["QI"], "bsdata": ["Imperium - Imperial Knights.json", "Imperium - Imperial Knights - Library.json", "Imperium - Adeptus Mechanicus.json"], "packVersion": "1.2", "wahapediaVersion": "1.2" },
 "spaceMarines":     { "wahapedia": ["SM"], "bsdata": ["Imperium - Space Marines.json", "Imperium - Ultramarines.json", "Imperium - Imperial Fists.json", "Imperium - Iron Hands.json", "Imperium - Raven Guard.json", "Imperium - Salamanders.json", "Imperium - White Scars.json"], "packVersion": "codex-11e", "wahapediaVersion": "codex-11e" },
